# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# STRIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# CJ DROPSHIPPING API
CJ_API_KEY=your_cj_api_key
# Si simulamos webhooks con CJ, usa este secreto (o lista blanca de IPs)
CJ_WEBHOOK_SECRET=your_cj_webhook_secret

# RESEND (EMAILS)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=ventas@bcconcept.com
ADMIN_NOTIFICATION_EMAIL=admin@bcconcept.com

# BIGBUY (proveedor principal; solo servidor, nunca NEXT_PUBLIC_)
# La key de supplier_credentials (BD) tiene prioridad sobre esta variable.
BIGBUY_API_KEY=
# Opcional. Producción por defecto (https://api.bigbuy.eu). Sandbox: https://api.sandbox.bigbuy.eu
BIGBUY_API_BASE=

# ADMIN (panel de importación)
# Emails con acceso, separados por comas. Vacía = nadie entra (fail-closed).
ADMIN_EMAILS=

# MARGEN (guarda configurable; sin valores por defecto en código).
# Si falta alguno, el margen se devuelve como null (params_not_configured).
MARGIN_VAT_PCT=
MARGIN_SHIPPING_EUR=
MARGIN_STRIPE_PCT=
MARGIN_STRIPE_FIXED_EUR=
MARGIN_RETURNS_BUFFER_PCT=
MARGIN_TARGET_MIN_PCT=
MARGIN_TARGET_MAX_PCT=

# APP CONFIG
NEXT_PUBLIC_APP_URL=http://localhost:3000
